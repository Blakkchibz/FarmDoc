<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.FarmDoc" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/farmdoc_brand_dark</item>
        <item name="colorPrimaryVariant">@color/farmdoc_brand_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/farmdoc_green</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="Theme.FarmDoc.NoActionBar" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/farmdoc_brand_dark</item>
        <item name="colorPrimaryVariant">@color/farmdoc_brand_dark</item>
        <item name="android:statusBarColor">@color/farmdoc_brand_dark</item>
    </style>

    <!-- Custom shape for thumbnails -->
    <style name="ShapeAppearanceOverlay.FarmDoc.RoundedSquare" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
</resources>
